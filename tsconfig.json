{
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "strict": true,
    "types": [
      "node"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
